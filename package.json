{
  "name": "w-commerce-workspace",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "postinstall": "node scripts/ensure-prisma-client.cjs",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "node scripts/ensure-prisma-client.cjs && npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm run db:generate:prod && npm run build:production",
    "build:production": "npm run build --workspace=frontend",
    "db:ensure": "node scripts/ensure-prisma-client.cjs",
    "db:generate:dev": "prisma generate --schema=database/prisma/schema.prisma",
    "db:sync-postgres-schema": "node scripts/sync-postgres-schema.cjs",
    "db:generate:prod": "node scripts/sync-postgres-schema.cjs && prisma generate --schema=database/prisma/postgres/schema.prisma",
    "prisma:generate": "prisma generate --schema=database/prisma/postgres/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=database/prisma/postgres/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=database/prisma/postgres/schema.prisma",
    "db:test-supabase": "node scripts/test-supabase-connection.cjs",
    "db:migrate-data": "node scripts/migrate-sqlite-to-postgres.cjs",
    "db:seed:prod": "node scripts/seed-from-sqlite.cjs",
    "db:sync:supabase": "node scripts/seed-from-sqlite.cjs",
    "db:sync:dry-run": "node scripts/seed-from-sqlite.cjs --dry-run",
    "env:validate": "node scripts/validate-production-env.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0"
  }
}
